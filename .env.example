# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/foji_dev

# ── Auth ─────────────────────────────────────────────────────
INTERNAL_API_KEY=change-me-shared-secret-with-foji-api

# ── AI Providers ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DYNAMODB_TABLE=foji-chats-dev
AWS_S3_BUCKET=foji-files-dev

# ── Google Calendar ──────────────────────────────────────────
# Must match FojiApi's GoogleCalendar:EncryptionKey exactly (base64, 32 bytes)
GOOGLE_CALENDAR_ENCRYPTION_KEY=
# Required only if foji-ai-api needs to refresh tokens (reads from encrypted DB field)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ──────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000,http://localhost:4321

# Dev switch: set to false to bypass subscription and usage limits while testing.
# Leave true (or unset) in production.
BILLING_ENFORCEMENT_ENABLED=true
